pkgname=t2fanrd
pkgver=r21.01df44d
pkgrel=2
_commit=01df44d1bcd555647e932c06086c411c984d197d
pkgdesc='Fan control daemon for Macs with the Apple T2 chip'
arch=('x86_64')
url='https://github.com/sharpenedblade/T2FanRD'
license=('GPL-3.0-or-later')
depends=('glibc' 'libgcc')
makedepends=('cargo' 'git')
conflicts=('t2fand')
replaces=('t2fand')
options=('!debug' '!lto')
source=("$pkgname::git+$url.git#commit=$_commit" 't2fanrd.service')
sha256sums=('1a488f6fe6070e047847ec07773f27776aed0ce4757f74516d51b7a2d02008b6'
            '57d30c12820700e134e95d5ed464754b5809bae7a6ec65bccaa2cab0620563a6')

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

package() {
    install -Dm0755 "$pkgname/target/release/t2fanrd" "$pkgdir/usr/bin/t2fanrd"
    install -Dm0644 t2fanrd.service "$pkgdir/usr/lib/systemd/system/t2fanrd.service"
    install -Dm0644 "$pkgname/LICENCE" "$pkgdir/usr/share/licenses/$pkgname/LICENCE"
}
