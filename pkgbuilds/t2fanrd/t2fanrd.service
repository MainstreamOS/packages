[Unit]
Description=Fan control for Macs with the Apple T2 chip
# Room for a fan driver that loads late, without restarting forever on a Mac
# whose fans the kernel does not see.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/t2fanrd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
