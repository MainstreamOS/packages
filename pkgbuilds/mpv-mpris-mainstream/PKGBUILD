# Maintainer: mainstreamos <https://github.com/MainstreamOS>
pkgname=mpv-mpris-mainstream
pkgver=1.3
pkgrel=3
pkgdesc='MPRIS plugin for mpv with an optional asynchronous episode metadata hook'
arch=(x86_64 aarch64)
url='https://github.com/hoyon/mpv-mpris'
license=(MIT)
depends=('mpv>=0.41' glib2 libavformat.so)
makedepends=(pkgconf)
checkdepends=(python dbus playerctl)
provides=("mpv-mpris=$pkgver")
conflicts=(mpv-mpris)
replaces=(mpv-mpris)
options=('!debug')
source=("mpv-mpris-$pkgver.tar.gz::https://codeload.github.com/hoyon/mpv-mpris/tar.gz/refs/tags/$pkgver" metadata-hook.patch test_metadata_hook.py)
sha256sums=('47deb26641b2f45edbbaf48a9136177b565b64f544f0fa7b956739fc7a4fc0a8'
            '9db278257aa2e833df35fd8386686452eaf77689e2f7143a6530c016e0d87aa1'
            '1da49d4b50fcc40e4c3d488b3edfc65cfd109b89212912b1dd04da5c0683b3c0')

prepare() {
  cd "mpv-mpris-$pkgver"
  patch -Np1 -i "$srcdir/metadata-hook.patch"
}

build() {
  make -C "mpv-mpris-$pkgver"
}

check() {
  dbus-run-session -- python3 "$srcdir/test_metadata_hook.py" "$srcdir/mpv-mpris-$pkgver/mpris.so"
}

package() {
  local upstream="$srcdir/mpv-mpris-$pkgver"
  install -Dm755 "$upstream/mpris.so" "$pkgdir/usr/lib/mpv-mpris-mainstream/mpris.so"
  install -d "$pkgdir/etc/mpv/scripts"
  ln -s /usr/lib/mpv-mpris-mainstream/mpris.so "$pkgdir/etc/mpv/scripts/mpris.so"
  install -Dm644 "$upstream/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
